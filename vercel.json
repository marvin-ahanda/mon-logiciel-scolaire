{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["cdg1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{media/**,staticfiles/**,db.sqlite3,**/tests.py,**/__pycache__/**,.git/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
