{
  "name": "nexiaschool-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NexIASchool — gestion des notes scolaires (React + Supabase, hébergé sur Netlify)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:cloudflare": "vite build && node scripts/cloudflare.mjs",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist --project-name nexiaschool --branch main",
    "deploy:maintien": "wrangler deploy --config workers/maintien/wrangler.toml",
    "dev:cloudflare": "npm run build:cloudflare && wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@fontsource/poppins": "5.2.7",
    "@supabase/supabase-js": "2.117.3",
    "bootstrap": "5.3.8",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "qrcode-generator": "2.0.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router-dom": "7.18.4",
    "read-excel-file": "9.3.12",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wrangler": "4.156.2"
  },
  "engines": {
    "node": ">=20"
  }
}
